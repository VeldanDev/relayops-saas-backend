{
  "name": "softlligence-saas-backend",
  "version": "1.0.0",
  "description": "Multi-Tenant SaaS Core Backend with strict tenant isolation, RBAC, and dynamic plan-based feature gating.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "npx prisma db push && node src/server.js",
    "vercel-build": "npx prisma generate && node scripts/build-template-db.js",
    "db:push": "npx prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:generate": "npx prisma generate",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "prisma": "^6.6.0"
  }
}
